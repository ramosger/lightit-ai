{
    "name": "lightit/lightit-ai",
    "description": "Light-it AI Stack TUI Installer — bootstrap your AI coding environment.",
    "keywords": ["ai", "cli", "tui", "installer", "engram", "rtk", "pao", "leann"],
    "homepage": "https://lightit.io",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Light-it",
            "email": "hello@lightit.io"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel-zero/framework": "^12.0.2"
    },
    "require-dev": {
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "build": "php application app:build lightit-ai",
        "test": "pest",
        "lint": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["application"]
}
